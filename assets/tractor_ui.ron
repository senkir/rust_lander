(
    spawn_rate: 0.05,            // a mote every 50ms, so a sparse, ambient feel
    spawn_amount: 180,             // more per tick to keep density with the shorter life
    emission_shape: Circle(150.0), // matches BEAM_RANGE in tractor/mod.rs
    lifetime: (0.4, 0.25),       // 0.3s to 0.5s: randomness is a fraction of the base, so max is 0.5s
    linear_speed: Some((40.0, 0.5)),   // faster so they still visibly drift in 0.4s
    linear_acceleration: Some((0.0, 0.0)),
    direction: Some(((0.0, 1.0), 1.0)), // wide spread (roughly a full circle) so they wander in every direction
    angular_speed: Some((0.5, 1.0)),
    angular_acceleration: Some((0.0, 0.0)),
    scale: Some((24.0, 0.6)), //TEMP: increase size
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)), // neutral base; the curve sets the green
    gravity_direction: Some(((0.0, 1.0), 0.0)),
    gravity_speed: Some((6.0, 0.5)), // slight upward float
    linear_damp: Some((0.6, 0.3)),
    angular_damp: Some((0.0, 0.0)),
    scale_curve: Some((points: [
        (0.0, 0.0, None),               // grow in
        (1.0, 0.25, Some(CubicOut)),
        (0.0, 1.0, Some(CubicIn))       // shrink out
    ])),
    color_curve: Some((points: [
        ((red: 0.2, green: 1.0, blue: 0.4, alpha: 0.0), 0.0, None),            // invisible at birth
        ((red: 0.3, green: 1.0, blue: 0.5, alpha: 0.8), 0.25, Some(CubicOut)), // bright green fade-in
        ((red: 0.1, green: 0.8, blue: 0.3, alpha: 0.5), 0.7, None),            // dimmer
        ((red: 0.0, green: 0.5, blue: 0.2, alpha: 0.0), 1.0, Some(CubicIn))    // fade out
    ])),
    attractors: None,
    relative_positioning: Some(true), // motes travel with the ship while it moves
)