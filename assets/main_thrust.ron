(
    spawn_rate: 0.01,            // was 0.1: spawn 10x as often
    spawn_amount: 8,             // was 1: several per tick, so it looks dense
    emission_shape: Circle(4.0), // small spread at the nozzle instead of a single point
    lifetime: (1.6, 0.8),        // was 15.0: short-lived flames (0.6s ± 0.4)
    linear_speed: Some((120.0, 0.4)),
    linear_acceleration: Some((0.0, 0.0)),
    direction: Some(((0.0, -1.0), 0.2)), // down, away from the ship; narrower cone
    angular_speed: Some((2.0, 1.0)),
    angular_acceleration: Some((0.0, 0.0)),
    scale: Some((6.0, 0.5)),
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)), // neutral base; the curve sets the fire colors
    gravity_direction: Some(((0.0, 0.0), 0.0)),
    gravity_speed: Some((0.0, 0.0)),
    linear_damp: Some((1.5, 0.3)), // slows the flames as they age, which gives a flicker/taper
    angular_damp: Some((0.0, 0.0)),
    scale_curve: Some(
        (points: [(24.0, 0.0, None),
            (0.0, 1.0, Some(CubicOut)
            )
        ])), // shrink to nothing
    color_curve: Some((points: [
        ((red: 1.0, green: 0.9, blue: 0.5, alpha: 1.0), 0.0,  None),          // hot yellow-white core
        ((red: 1.0, green: 0.45, blue: 0.05, alpha: 0.9), 0.35, None),        // orange
        ((red: 0.8, green: 0.1, blue: 0.02, alpha: 0.5), 0.7, None),          // red
        ((red: 0.2, green: 0.02, blue: 0.0, alpha: 0.0), 1.0, Some(CubicOut)) // fade to dark and transparent
    ])),
    attractors: None,
    relative_positioning: Some(false),
)