(
    spawn_rate: 0.01,
    spawn_amount: 3,
    emission_shape: Circle(1.0),          // near a point source
    lifetime: (0.25, 0.2),                // short, so the jet stays compact
    linear_speed: Some((420.0, 0.1)),     // fast, with little speed variation
    linear_acceleration: Some((0.0, 0.0)),
    direction: Some(((-1.0, 0.0), 0.03)), // very narrow cone
    angular_speed: Some((0.0, 0.0)),
    angular_acceleration: Some((0.0, 0.0)),
    scale: Some((36.0, 0.0)),              // overridden by scale_curve
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)), // overridden by color_curve
    gravity_direction: Some(((0.0, 0.0), 0.0)),
    gravity_speed: Some((0.0, 0.0)),
    linear_damp: Some((0.0, 0.0)),        // no slowing, so it stays a straight line
    angular_damp: Some((0.0, 0.0)),
    scale_curve: Some((points: [
        (27.0, 0.0, None),
        (2.0, 1.0, Some(CubicOut)),       // tapers to a fine tip
    ])),
    color_curve: Some((points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0), 0.0, None),    // white-hot
        ((red: 0.6, green: 0.9, blue: 1.0, alpha: 0.9), 0.4, None),    // pale cyan
        ((red: 0.2, green: 0.5, blue: 1.0, alpha: 0.0), 1.0, Some(CubicOut)),
    ])),
    attractors: None,
    relative_positioning: Some(true),
)